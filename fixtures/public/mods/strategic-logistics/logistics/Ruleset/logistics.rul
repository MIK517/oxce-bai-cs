countries:
  - type: COUNTRY
    fundingBase: 100
    fundingCap: 400
    areas: [[0, 30, -20, 20]]
regions:
  - type: REGION
    areas: [[0, 30, -20, 20]]
research:
  - name: UNLOCK
commendations:
  - type: STR_MEDAL_ORIGINAL8_NAME
    description: Original recruit
    soldierBonusTypes: [PILOT_BONUS]
soldierBonuses:
  - name: PILOT_BONUS
    stats: {tu: 10}
items:
  - type: CORPSE
    battleType: 11
  - type: SUPPLY
    costBuy: 199
    costSell: 100
    size: 1
    transferTime: 1
    monthlyBuyLimit: 10
  - type: LOCKED
    costBuy: 50
    requires: [UNLOCK]
    transferTime: 1
  - type: BULKY
    costBuy: 20
    size: 2
    transferTime: 1
armors:
  - type: ARMOR
    storeItem: SUPPLY
    corpseBattle: [CORPSE]
    corpseGeo: CORPSE
    loftempsSet: [0]
soldiers:
  - type: RECRUIT
    armor: ARMOR
    costBuy: 500
    transferTime: 1
    soldierNames: [SoldierName/test.nam]
    minStats: {tu: 50, stamina: 60, health: 30, mana: 20, bravery: 25, reactions: 40, firing: 55, throwing: 45, strength: 25, psiStrength: 35, melee: 30, psiSkill: 0}
    maxStats: {tu: 50, stamina: 60, health: 30, mana: 20, bravery: 25, reactions: 40, firing: 55, throwing: 45, strength: 25, psiStrength: 35, melee: 30, psiSkill: 50}
  - type: TEMPLATE_RECRUIT
    refNode: &recruitTemplate
      armor: ARMOR
      costBuy: 750
      transferTime: 1
      soldierNames: [SoldierName/test.nam]
      minStats: {tu: 50, health: 30, mana: 20}
      maxStats: {tu: 50, health: 30, mana: 20}
    spawnedSoldier:
      id: 999
      name: Template name
      nationality: 8
      initialStats: {tu: 70, health: -1}
      currentStats: {tu: 0, mana: -1}
      rank: 2
      missions: 3
      kills: 4
      recovery: 1.5
      training: true
      armor: ARMOR
      previousTransformations: {PREVIOUS: 2}
      transformationBonuses: {BONUS_A: 3}
      randomTransformationBonuses: {BONUS_B: 1, "": 1, BONUS_A: 1, DISABLED_BONUS: 0}
      transformationBonusesCount: 5
craftWeapons:
  - type: NEGATIVE_CAPACITY
    ammoMax: 10
    rearmRate: 3
    launcher: SUPPLY
    clip: BULKY
    stats: {soldiers: -1}
  - type: FIXED
    ammoMax: 10
    launcher: SUPPLY
    clip: BULKY
crafts:
  - type: CARRIER
    soldiers: 2
  - type: INTERCEPTOR
    soldiers: 1
    pilots: 1
    allowLanding: false
    pilotMinStatsRequired: {tu: 60}
    pilotSoldierBonusesRequired: [PILOT_BONUS]
  - type: SHIP
    costBuy: 1000
    costSell: 500
    transferTime: 1
    fuelMax: 100
    weapons: 2
    fixedWeapons: [FIXED]
facilities:
  - type: STORES
    mapName: LOGISTICS
    storage: 10
    personnel: 10
    crafts: 2
startingBase:
  facilities: [{type: STORES, x: 0, y: 0}]
  items: {SUPPLY: 2}
  scientists: 1
  engineers: 1
startingTime: {weekday: 1, day: 1, month: 1, year: 1999, hour: 0, minute: 59, second: 55}
startingBaseVeteran:
  randomSoldiers: {RECRUIT: 4}
  facilities: [{type: STORES, x: 0, y: 0}]
  items: {SUPPLY: 2}
  crafts:
    - {type: CARRIER, id: 1}
    - {type: INTERCEPTOR, id: 1}
    - type: SHIP
      id: 1
      weapons: [{type: NEGATIVE_CAPACITY, ammo: 8}, {type: FIXED, ammo: 0}]
      items: {SUPPLY: 4}
initialFunding: 100
costHireScientist: 1000
costHireEngineer: 500
timePersonnel: 1
buyPriceCoefficient: [75, 100, 100, 100, 100]
