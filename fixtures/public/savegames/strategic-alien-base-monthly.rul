alienDeployments:
  - type: MONTHLY_craftMarker
    alienBase: true
    markerName: SHIP
  - type: MONTHLY_craftMarkerUpgrade
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_craftMarker: 1}}
  - type: MONTHLY_legacyMarker
    alienBase: true
    markerName: STR_ALIEN_TERROR
  - type: MONTHLY_legacyMarkerUpgrade
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_legacyMarker: 1}}
  - &monthlyNew
    type: MONTHLY_NEW
    alienBase: true
    markerName: STR_ALIEN_BASE_NEW
    points: 7
    huntMissionMaxFrequency: 120
  - type: MONTHLY_RESET
    refNode: *monthlyNew
    resetAlienBaseAge: true
  - type: MONTHLY_UNKNOWN_RACE
    refNode: *monthlyNew
    upgradeRace: MISSING
  - type: MONTHLY_EVOLVED
    refNode: *monthlyNew
    upgradeRace: RACE_B
    alienRaceEvolution: [[3, RACE_B, RACE_C]]
  - &monthlyUpgrade
    type: MONTHLY_upgrade
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_NEW: 1}}
  - type: MONTHLY_monthZero
    refNode: *monthlyUpgrade
  - type: MONTHLY_notNewMonth
    refNode: *monthlyUpgrade
  - type: MONTHLY_noWeights
    alienBase: true
    markerName: STR_ALIEN_BASE
  - type: MONTHLY_sourceReset
    refNode: *monthlyUpgrade
    resetAlienBaseAgeAfterUpgrade: true
  - type: MONTHLY_targetReset
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_RESET: 1}}
  - type: MONTHLY_unknownUpgrade
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MISSING: 1}}
  - type: MONTHLY_sameUpgrade
    alienBase: true
    markerName: STR_ALIEN_BASE
    resetAlienBaseAgeAfterUpgrade: true
    upgradeRace: RACE_B
    alienBaseUpgrades: {0: {MONTHLY_sameUpgrade: 1}}
  - type: MONTHLY_emptyUpgrade
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {'': 1}}
  - type: MONTHLY_zeroWeights
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_NEW: 0}}
  - type: MONTHLY_unknownRace
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_UNKNOWN_RACE: 1}}
  - type: MONTHLY_upgradeEvolution
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_EVOLVED: 1}}
  - type: MONTHLY_evolutionChain
    alienBase: true
    markerName: STR_ALIEN_BASE
    # The loader sorts months descending, keeping equal-month source order.
    alienRaceEvolution: [[1, RACE_A, RACE_B], [2, RACE_B, RACE_C]]
  - type: MONTHLY_priority
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienRaceEvolution: [[1, RACE_A, RACE_B], [3, RACE_A, RACE_C]]
  - type: MONTHLY_stableTie
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienRaceEvolution: [[2, RACE_A, RACE_B], [2, RACE_A, RACE_C]]
  - type: MONTHLY_missingEvolution
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienRaceEvolution: [[2, RACE_A, MISSING], [1, RACE_A, RACE_B]]
  - type: MONTHLY_futureEvolution
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienRaceEvolution: [[4, RACE_A, RACE_B]]
  - type: MONTHLY_selfLoop
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienRaceEvolution: [[1, RACE_A, RACE_A]]
  - type: MONTHLY_cycle
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienRaceEvolution: [[1, RACE_A, RACE_B], [1, RACE_B, RACE_A]]
  - type: MONTHLY_timelineEarly
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_timelineEarly: 1}, 2: {MONTHLY_NEW: 1}}
  - type: MONTHLY_timelineBoundary
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_timelineBoundary: 1}, 2: {MONTHLY_NEW: 1}}
  - type: MONTHLY_futureStart
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_futureStart: 1}, 2: {MONTHLY_NEW: 1}}
  - type: MONTHLY_futureTimeline
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {4: {MONTHLY_NEW: 1}}
  - type: MONTHLY_badHuntTimer
    alienBase: true
    markerName: STR_ALIEN_BASE
    huntMissionMaxFrequency: -1
  - type: MONTHLY_badUpgrade
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_badHuntTimer: 1}}
  - type: MONTHLY_badEvolutionUpgrade
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_NEW: 1, MONTHLY_cycle: 1}}
  - type: MONTHLY_overflowWeights
    alienBase: true
    markerName: STR_ALIEN_BASE
    alienBaseUpgrades: {0: {MONTHLY_NEW: 2147483647, MONTHLY_RESET: 1}}
  - type: MONTHLY_chain99
    alienBase: true
    markerName: STR_ALIEN_BASE
