alienMissions:
  - type: FALLBACK_RACE
    objective: 0
    raceWeights: {0: {RACE_B: 1}, 20: {RACE_A: 1}}
    waves: [{ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: FUTURE_RACE
    objective: 0
    raceWeights: {20: {RACE_B: 1}}
    waves: [{ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: INVALID_RACE
    objective: 0
    raceWeights: {0: {MISSING_RACE: 1}}
    waves: [{ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: EXCESS_RACE
    objective: 0
    raceWeights: {0: {RACE_A: 2147483647, RACE_B: 1}}
    waves: [{ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
missionScripts:
  - type: FALLBACK
    firstMonth: 10
    lastMonth: 10
    varName: FALLBACK_RUN
    maxRuns: 1
    missionWeights: {0: {FALLBACK_RACE: 1}}
    regionWeights: {0: {REGION: 1}}
  - type: FUTURE
    firstMonth: 11
    lastMonth: 11
    missionWeights: {0: {FUTURE_RACE: 1}}
    regionWeights: {0: {REGION: 1}}
  - type: INVALID
    firstMonth: 12
    lastMonth: 12
    missionWeights: {0: {INVALID_RACE: 1}}
    regionWeights: {0: {REGION: 1}}
  - type: EXCESS
    firstMonth: 13
    lastMonth: 13
    missionWeights: {0: {EXCESS_RACE: 1}}
    regionWeights: {0: {REGION: 1}}
  - type: OVERRIDE
    firstMonth: 14
    lastMonth: 14
    missionWeights: {0: {FUTURE_RACE: 1}}
    regionWeights: {0: {REGION: 1}}
    raceWeights: {0: {RACE_A: 1}}
