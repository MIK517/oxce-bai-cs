events:
  - name: EVENT_DEFAULT
  - name: EVENT_REPEAT
    timer: 119
    timerRandom: 0
    interruptResearch: STOP_EVENT
  - name: EVENT_RANDOM
    timer: 31
    timerRandom: 90
  - name: EVENT_INVALID
    timerRandom: -1
  - name: EVENT_OVERFLOW
    timer: 2147483647
    timerRandom: 1
  - name: EVENT_REPEATABLE
    interruptResearch: REPEATABLE_STOP
  - name: EVENT_SECOND
    interruptResearch: SECOND_STOP
research:
  - name: STOP_EVENT
    cost: 1
  - name: EVENT_SOURCE
    cost: 1
    disables: [STOP_EVENT]
    spawnedEvent: EVENT_REPEAT
    events: {EVENT_REPEAT: 1}
  - name: BAD_SOURCE
    cost: 1
    spawnedEvent: EVENT_INVALID
  - name: EVENT_LOOKUP
    cost: 1
    lookup: STOP_EVENT
  - name: FREE_DISABLER
    cost: 1
    getOneFree: [EVENT_SOURCE]
  - name: REPEATABLE_STOP
    cost: 1
    repeatable: true
  - name: SECOND_STOP
    cost: 1
  - name: TRIGGER_ZERO
    cost: 1
  - name: ZERO_DISABLER
    cost: 0
    dependencies: [TRIGGER_ZERO]
    disables: [SECOND_STOP]
manufacture:
  - name: EVENT_PRODUCT
    time: 1
    producedItems: {BULKY: 1}
    events: {EVENT_REPEAT: 1}
facilities:
  - type: STORES
    labs: 10
    workshops: 10
startingBase:
  facilities: [{type: STORES, x: 0, y: 0}]
  scientists: 3
  engineers: 4
