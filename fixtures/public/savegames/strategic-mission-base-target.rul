regions:
  - type: REGION_SECOND
    areas: [[40, 50, -20, 20]]
alienMissions:
  - type: MISSION_A
    objective: 0
    raceWeights: {0: {RACE_A: 1}}
    waves: [{ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: MISSION_B
    objective: 0
    raceWeights: {0: {RACE_A: 1}}
    waves: [{ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
missionScripts:
  - type: BASE_TARGET
    firstMonth: 18
    lastMonth: 19
    targetBaseOdds: 100
    missionWeights: {0: {MISSION_A: 1, MISSION_B: 99}}
    startDelay: 60
    varName: BASE_RUN
    label: 1
  - type: AFTER_BUSY
    firstMonth: 19
    lastMonth: 19
    conditionals: [-1]
    missionWeights: {0: {MISSION_SCOUT: 1}}
    regionWeights: {0: {REGION: 1}}
    startDelay: 60
    varName: AFTER_BUSY_RUN
  - type: SINGLE_TARGET
    firstMonth: 20
    lastMonth: 20
    targetBaseOdds: 100
    missionWeights: {21: {MISSION_A: 1}}
    startDelay: 60
    varName: BASE_RUN
