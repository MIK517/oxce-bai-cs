# World-simulation overlay for the strategic-logistics fixture master: a globe with land,
# fake-underwater and ocean textures, a region with point and area mission zones, UFOs,
# trajectories, alien missions and the deployments their sites and bases use.
crafts:
  - type: SHIP
    speedMax: 6000
    damageMax: 100
    refuelRate: 100
    autoPatrol: true
    patrolWithoutFuel: true
  - type: SHIP_SLOW_REFUEL
    speedMax: 6000
    damageMax: 100
    fuelMax: 300
    refuelRate: 100
    weapons: 2
    autoPatrol: true
    radarRange: 0
    radarChance: 0
  - type: SHIP_FUEL_ITEM
    speedMax: 6000
    damageMax: 100
    fuelMax: 100
    refuelRate: 100
    refuelItem: SUPPLY
    weapons: 2
    autoPatrol: true
    radarRange: 1000
    radarChance: 100
craftWeapons:
  # A transferring auto-patrol craft must reject effective speed overflow before arrival.
  - type: SPEED_EXCESS
    ammoMax: 0
    launcher: SUPPLY
    stats: {speedMax: 2147483647}
  - type: RADAR_BOOST
    ammoMax: 1
    launcher: SUPPLY
    clip: BULKY
    stats: {radarRange: 1000, radarChance: 100}
  - type: RADAR_EXCESS
    ammoMax: 1
    launcher: SUPPLY
    clip: BULKY
    stats: {radarRange: 1000, radarChance: 101}
facilities:
  # Six tiles cross Base::getDetectionChance's area/6 threshold with the starting store.
  - type: DETECTION_AREA_TEST
    mapName: LOGISTICS
    sizeX: 2
    sizeY: 3
  - type: MIND_SCREEN_TEST
    mapName: LOGISTICS
    mind: true
    mindPower: 99
  - type: MIND_SCREEN_INVALID
    mapName: LOGISTICS
    mind: true
    mindPower: -1
  - type: FUEL_WORKSHOP
    mapName: LOGISTICS
    workshops: 1
    labs: 1
  - type: RADAR_TEST
    mapName: LOGISTICS
    radarRange: 1000
    radarChance: 100
  # Base::detect accepts sums above 100; ordinary radar still applies UFO visibility.
  - type: RADAR_OVER_TEST
    mapName: LOGISTICS
    radarRange: 1000
    radarChance: 150
  - type: RADAR_HYPER_TEST
    mapName: LOGISTICS
    radarRange: 1000
    radarChance: 100
    hyper: true
globe:
  polygons:
    - [10, 0, -10, 20, -10, 20, 10, 0, 10]
    - [11, 20, -10, 30, -10, 30, 10, 20, 10]
    - [12, 40, -10, 60, -10, 60, 10, 40, 10]
  textures:
    - {id: 10, deployments: {SITE_DEPLOY: 3, SITE_DEPLOY_B: 1}}
    - {id: 11, fakeUnderwater: true, deployments: {SITE_DEPLOY: 1}}
    - {id: 12, isOcean: true}
regions:
  - type: REGION
    cost: 5000
    regionWeight: 10
    missionWeights:
      MISSION_SCOUT: 4
      MISSION_SITE: 2
    missionZones:
      - [[2, 28, -18, 18, 10]]
      - [[8, 8, 2, 2, 10, CITY_ALPHA], [12, 12, -2, -2, 10, CITY_BETA]]
      - [[22, 28, -8, 8, 11]]
      # Target::setLongitude wraps this reference-valid range after selection.
      - [[362, 362, 2, 2, 10, CITY_WRAPPED]]
      - [[10, 10, 8, 8, 10, CITY_SPAWN]]
      # Nearby land points keep the short lifecycle scenario quick; the long
      # trajectory below also crosses ten-minute and half-hour boundaries.
      - [[8, 8, 2, 2, 10, LANDING_POINT]]
      - [[8.01, 8.01, 2, 2, 10, DEPARTURE_POINT]]
alienRaces:
  - id: RACE_A
    members: [SECTOID]
  - id: RACE_B
    members: [SECTOID]
alienDeployments:
  # The legacy terrorSites node is imported with this fixed mission type and deployment.
  - type: STR_TERROR_MISSION
    markerName: STR_TERROR_SITE
    duration: [2, 4]
    points: 3
    race: RACE_A
  - type: SITE_DEPLOY
    markerName: STR_TERROR_SITE
    markerIcon: 8
    duration: [3, 6]
    points: 4
    despawnPenalty: 9
    race: RACE_A
    unlockedResearchOnDespawn: UNLOCK
    counterDespawn: sitesDespawned
    counterAll: sitesAll
    decreaseCounterFailure: sitesWon
    despawnEvents:
      EVENT_DESPAWN: 5
  - type: SITE_DEPLOY_B
    markerName: STR_TERROR_SITE
    duration: [1, 1]
    points: 1
    race: RACE_B
  - type: ALIEN_BASE_DEPLOY
    markerName: STR_ALIEN_BASE
    alienBase: true
    points: 7
    race: RACE_A
    fakeUnderwaterSpawnChance: 25
    baseDetectionRange: 600
    baseDetectionChance: 40
    huntMissionMaxFrequency: 90
    genMissionFreq: 6
    genMissionLimit: 3
    genMission:
      MISSION_SUPPLY: 10
    huntMissionWeights:
      0: {MISSION_SCOUT: 5}
      4: {MISSION_SCOUT: 1, MISSION_SITE: 9}
    alienBaseUpgrades:
      0: {ALIEN_BASE_DEPLOY_UPGRADED: 100}
    alienRaceEvolution:
      - [6, RACE_A, RACE_B]
    baseSelfDestructCode: UNLOCK
  - type: ALIEN_BASE_DEPLOY_UPGRADED
    markerName: STR_ALIEN_BASE
    alienBase: true
    points: 11
    race: RACE_B
    resetAlienBaseAge: true
ufos:
  - type: UFO_SCAN_TEST
    size: STR_SMALL
    speedMax: 2200
    damageMax: 50
    sightRange: 0
    raceBonus:
      RACE_B:
        sightRange: 268
  - type: UFO_SCAN_UNMANNED
    size: STR_SMALL
    unmanned: true
    speedMax: 2200
    damageMax: 50
    sightRange: 268
  - type: UFO_SCAN_BOUNDARY
    size: STR_SMALL
    speedMax: 2200
    damageMax: 50
    sightRange: 5400
  - type: UFO_SCOUT
    size: STR_SMALL
    marker: 2
    missionScore: 3
    fakeWaterLandingChance: 20
    speedMax: 2200
    damageMax: 50
    radarRange: 300
    radarChance: 100
    sightRange: 268
    shieldCapacity: 0
    raceBonus:
      RACE_B:
        speedMax: 300
        damageMax: 10
  # Detection-neutral UFO for the bounded wave-spawn slice. A half-hour spawn
  # is scored and detected later in the same reference handler.
  - type: UFO_SPAWN
    size: STR_SMALL
    missionScore: 0
    speedMax: 2200
    damageMax: 50
    shieldCapacity: 0
  - type: UFO_LANDING_SILENT
    size: STR_SMALL
    missionScore: 3
    noAlert: true
    speedMax: 2200
    damageMax: 50
  - type: UFO_HUNTER
    size: STR_LARGE
    visibility: 22
    hunterKillerPercentage: 100
    huntMode: 1
    huntBehavior: 0
    huntSpeed: 80
    unmanned: true
    noAlert: true
    speedMax: 4000
    damageMax: 500
    radarRange: 600
    radarChance: 50
    sightRange: 400
    raceBonus:
      RACE_B:
        shieldCapacity: 2
ufoTrajectories:
  # Current zone 5 is explicitly excluded by DetectXCOMBase, even after point 1.
  - id: TRAJ_BASE_SCAN_EXCLUDED
    waypoints:
      - [0, 3, 100]
      - [0, 2, 80]
      - [5, 2, 50]
  - id: TRAJ_LONG_LANDING
    groundTimer: 360
    waypoints:
      - [4, 3, 100]
      - [5, 2, 80]
      - [6, 0, 50]
      - [6, 1, 100]
  # Non-city land selection must reject unsuitable candidates in mission zone 0.
  - id: TRAJ_LANDING_AREA
    groundTimer: 2
    waypoints:
      - [4, 3, 100]
      - [0, 2, 80]
      - [6, 0, 50]
      - [6, 1, 100]
  - id: TRAJ_LANDING
    groundTimer: 2
    waypoints:
      - [4, 3, 100]
      - [5, 2, 80]
      - [6, 0, 50]
      - [6, 1, 100]
  # An early ground point isolates half-hour accounting from later-point
  # ten-minute UFO base scans.
  - id: TRAJ_LANDING_EARLY
    groundTimer: 2
    waypoints:
      - [5, 3, 100]
      - [6, 0, 50]
      - [6, 1, 100]
  # Invalid timers must be rejected before a ground arrival publishes any state.
  - id: TRAJ_LANDING_ZERO
    groundTimer: 0
    waypoints:
      - [5, 3, 100]
      - [6, 0, 50]
      - [6, 1, 100]
  - id: TRAJ_LANDING_OVERFLOW
    groundTimer: 2147483647
    waypoints:
      - [5, 3, 100]
      - [6, 0, 50]
      - [6, 1, 100]
  - id: TRAJ_PATROL
    groundTimer: 12
    waypoints:
      - [0, 3, 100]
      - [1, 2, 80]
      - [0, 0, 50]
      - [0, 1, 100]
  # Keeps the following waypoint airborne so transit tests isolate the ordinary
  # regional retargeting path from land-point selection and UFO landing.
  - id: TRAJ_AIRBORNE
    groundTimer: 12
    waypoints:
      - [0, 3, 100]
      - [3, 2, 80]
      - [0, 3, 50]
  - id: TRAJ_AIRBORNE_SPAWN
    groundTimer: 12
    waypoints:
      - [0, 3, 100]
      - [0, 2, 80]
      - [0, 3, 50]
  # Fixed, separated initial points let preflight prove that a newly spawned UFO
  # cannot also reach its first destination later in the same time tick.
  - id: TRAJ_SPAWN_FIXED
    groundTimer: 12
    waypoints:
      - [4, 3, 100]
      - [3, 2, 80]
      - [0, 3, 50]
  - id: TRAJ_SITE
    groundTimer: 6
    waypoints:
      - [0, 3, 100]
      - [1, 0, 60]
      - [0, 4, 100]
  - id: __RETALIATION_ASSAULT_RUN
    groundTimer: 5
    waypoints:
      - [5, 3, 100]
      - [5, 0, 100]
alienMissions:
  # Finite endurance workload: each following UFO is 30-90 minutes away.
  - type: MISSION_ENDURANCE
    objective: 0
    points: 7
    waves:
      - {ufo: UFO_SCOUT, count: 36, trajectory: TRAJ_LONG_LANDING, timer: 60}
  - type: MISSION_LONG_LANDING
    objective: 0
    points: 7
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_LONG_LANDING, timer: 9000}
  - type: MISSION_LANDING
    objective: 0
    points: 7
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_LANDING, timer: 9000}
  - type: STR_ALIEN_TERROR
    points: 4
    objective: 3
    spawnZone: 1
    siteType: STR_TERROR_MISSION
    raceWeights:
      0: {RACE_A: 1}
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_SITE, timer: 3000, objective: true}
  - type: MISSION_SCOUT
    points: 2
    objective: 0
    raceWeights:
      0: {RACE_A: 10}
    waves:
      - {ufo: UFO_SCOUT, count: 2, trajectory: TRAJ_PATROL, timer: 9000}
      - {ufo: UFO_HUNTER, count: 1, trajectory: TRAJ_PATROL, timer: 12000, hunterKillerPercentage: 100, huntMode: 0, huntBehavior: 1, escort: true, interruptPercentage: 50}
  # All objective flags are deliberately present. Outside the mission's spawn
  # zone, AlienMission::getWaypoint still chooses an ordinary regional point.
  - type: MISSION_AIRBORNE_FLAGS
    objective: 0
    spawnZone: 0
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 9000, objective: true, objectiveOnTheLandingSite: true, objectiveOnXcomBase: true}
  - type: MISSION_SPAWN_AIRBORNE
    objective: 0
    waves:
      - {ufo: UFO_SPAWN, count: 2, trajectory: TRAJ_SPAWN_FIXED, timer: 9000}
  - type: MISSION_SPAWN_SCORED
    objective: 0
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_SPAWN_FIXED, timer: 9000}
  # A wave without a UFO or deployment still advances AlienMission's counters.
  - type: MISSION_EMPTY_WAVE
    objective: 0
    waves:
      - {count: 2, trajectory: TRAJ_PATROL, timer: 90}
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 3000}
  - type: MISSION_EMPTY_FINAL
    objective: 0
    waves:
      - {count: 1, trajectory: TRAJ_PATROL, timer: 90}
  - type: MISSION_EMPTY_RECURSIVE
    objective: 0
    waves:
      - {count: 1, trajectory: TRAJ_PATROL, timer: 90}
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 0}
  - type: MISSION_SITE
    points: 5
    objective: 3
    spawnZone: 1
    siteType: SITE_DEPLOY
    raceWeights:
      0: {RACE_A: 5, RACE_B: 5}
    regionWeights:
      0: {REGION: 1}
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_SITE, timer: 3000, objective: true}
  - type: MISSION_BASE
    points: 8
    objective: 2
    spawnZone: 2
    siteType: ALIEN_BASE_DEPLOY
    raceWeights:
      0: {RACE_A: 1}
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_SITE, timer: 3000, objectiveOnTheLandingSite: true}
  - type: MISSION_RETALIATION
    points: 6
    objective: 4
    spawnUfo: UFO_HUNTER
    interruptResearch: UNLOCK
    raceWeights:
      0: {RACE_A: 1}
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 3000}
  - type: MISSION_INSTANT_RETALIATION
    objective: 6
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 3000}
  - type: MISSION_SUPPLY
    points: 3
    objective: 5
    operationType: 1
    operationSpawnZone: 0
    operationBaseType: ALIEN_BASE_DEPLOY
    raceWeights:
      0: {RACE_A: 1}
    waves:
      - {ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_PATROL, timer: 3000, objective: true}
# Small deterministic deliveries exercise the order before half-hour craft refuelling.
manufacture:
  - name: FUEL_PRODUCTION
    time: 2
    producedItems: {SUPPLY: 1}
  - name: FUEL_RANDOM_PRODUCTION
    time: 2
    producedItems: {SUPPLY: 0}
    randomProducedItems:
      - [1, {SUPPLY: 1}]
  - name: FUEL_DELAYED_PRODUCTION
    time: 2
    transferTimes: [1]
    producedItems: {SUPPLY: 1}
  - name: OTHER_PRODUCTION
    time: 2
    producedItems: {BULKY: 1}
research:
  - name: FUEL_RESEARCH
    cost: 1
    spawnedItem: SUPPLY
  - name: FUEL_RESEARCH_REWARD
    cost: 1
    getOneFree: [FUEL_RESEARCH]
  - name: FUEL_RESEARCH_RETURN
    cost: 1
    needItem: true
    neededItem: SUPPLY
    returnsItem: true
events:
  - name: EVENT_DESPAWN
    description: STR_EVENT_DESPAWN
    points: 3
    timer: 30
