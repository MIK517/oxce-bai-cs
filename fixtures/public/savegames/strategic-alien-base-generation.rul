alienMissions:
  - type: GEN_local
    objective: 5
    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: GEN_weighted
    objective: 0
    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
    regionWeights: {0: {REGION_SECOND: 1}}
    raceWeights: {0: {RACE_B: 1}}
  - type: GEN_target
    objective: 5
    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
    regionWeights: {0: {REGION_SECOND: 1}}
    targetBaseOdds: 100
  - type: GEN_baseRace
    objective: 5
