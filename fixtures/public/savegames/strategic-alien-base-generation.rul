# Synthetic daily base-generated missions. No original assets.
regions:
  - type: REGION_SECOND
    areas: [[40, 50, -20, 20]]
    missionRegion: REGION
  - type: REGION_BAD_FALLBACK
    missionRegion: MISSING_REGION
