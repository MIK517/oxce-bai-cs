  - type: GEN_immediateLimit
    waves: [{count: 4097, trajectory: TRAJ_PATROL, timer: 0}]
research:
  - name: GEN_STOP
    cost: 5
  - name: GEN_SOURCE
    cost: 5
    lookup: GEN_STOP
  - name: GEN_REWARD
    cost: 5
    getOneFree: [GEN_STOP]
  - name: GEN_OTHER
    cost: 5
  - name: GEN_DISABLE
    cost: 5
    disables: [GEN_STOP]
facilities:
  - type: GEN_LAB
    mapName: LOGISTICS
    labs: 5
