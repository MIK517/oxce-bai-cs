    objective: 3
    spawnZone: 99
    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: GEN_WEIGHT_OVERFLOW
    regionWeights: {0: {REGION: 2147483648}}
    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: GEN_INVALID_FALLBACK
    regionWeights: {0: {REGION_BAD_FALLBACK: 1}}
    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: GEN_objective0
    objective: 0
    spawnZone: 1
    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
