    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 120}]
  - type: GEN_INTERRUPT
    interruptResearch: UNLOCK
    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: GEN_STOP_TOPIC
    interruptResearch: GEN_STOP
    waves: [{ufo: UFO_HUNTER, count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: GEN_SCORED_INTERRUPT
    interruptResearch: GEN_STOP
    waves: [{ufo: UFO_SCOUT, count: 1, trajectory: TRAJ_SPAWN_FIXED, timer: 9000}]
  - type: GEN_MISSING_INTERRUPT
    interruptResearch: MISSING_RESEARCH
    waves: [{count: 1, trajectory: TRAJ_PATROL, timer: 9000}]
  - type: GEN_RETALIATION_INTERRUPT
    objective: 4
    interruptResearch: UNLOCK
